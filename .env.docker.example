# Modelo do .env.docker, lido pelo `env_file` do docker-compose.yml.
# Copie antes de subir a stack:
#
#     cp .env.docker.example .env.docker   (cmd.exe: copy ...)
#
# O arquivo é opcional (`required: false` no compose): sem ele a stack ainda
# sobe. Precedência dentro do container, do mais forte para o mais fraco:
#
#     environment: do compose  >  .env.docker  >  .env  >  config/*.yml
#
# O `.env` aparece nessa lista porque o compose monta a pasta do projeto
# dentro do container — então o arquivo do modo dev fica visível ali e serve
# de fallback.
#
# A estrutura e os defaults ficam em config/*.yml — este arquivo só os
# sobrepõe, com os valores que fazem sentido DENTRO do container.
#
# ATENÇÃO: uma variável definida como VAZIA aqui vence o default do YAML.
# Para ficar com o default, comente a linha em vez de deixá-la vazia.

NODE_ENV=development

# ─────────────────────────────────────────────────────────────────────────────
# Postgres
# ─────────────────────────────────────────────────────────────────────────────

# POSTGRES_HOST NÃO entra aqui: dentro da rede do compose o banco atende pelo
# nome do serviço, e isso é topologia, não configuração de quem desenvolve.
# Quem define é o bloco `environment:` do docker-compose.yml, que tem
# precedência sobre este arquivo — para a stack subir certa mesmo sem ele.

POSTGRES_PASSWORD=postgres

# Os demais têm default em config/default.yml e batem com o docker-compose.yml.
# POSTGRES_PORT=5432
# POSTGRES_USER=postgres
# POSTGRES_DB=payments

# ─────────────────────────────────────────────────────────────────────────────
# Aplicação
# ─────────────────────────────────────────────────────────────────────────────

# Porta HTTP dentro do container. Mudando aqui, ajuste também o mapeamento
# `ports:` do docker-compose.yml, senão a API deixa de responder em :3000.
# PORT=3000

# ─────────────────────────────────────────────────────────────────────────────
# Mercado Pago
# ─────────────────────────────────────────────────────────────────────────────

# Vazio faz a API usar o gateway simulado, sem falar com o Mercado Pago.
MERCADO_PAGO_ACCESS_TOKEN=

# Assinatura secreta do painel → Webhooks. Vazia desliga a verificação do
# x-signature (só aceitável em desenvolvimento). Preenchida com um valor que
# não seja o do painel, a API rejeita com 401 as notificações legítimas.
MERCADO_PAGO_WEBHOOK_SECRET=

# URL pública do túnel (pnpm tunnel). localhost não serve aqui: quem chama
# essas URLs é o Mercado Pago, de fora da sua máquina.
#
# Comentadas, a preferência sai sem notification_url e sem back_urls — sem
# callback e sem retorno do cliente. É o correto para rodar sem túnel: melhor
# omitir do que apontar para um endereço que o provedor não alcança.
# MERCADO_PAGO_NOTIFICATION_URL=https://<id>.trycloudflare.com/api/payment/webhook
# MERCADO_PAGO_BACK_URL=https://<id>.trycloudflare.com

# ─────────────────────────────────────────────────────────────────────────────
# Temporal.io
# ─────────────────────────────────────────────────────────────────────────────

# Cada cobrança por cartão vira um workflow durável. O compose já sobe o
# servidor antes da API (depends_on). UI em http://localhost:8233.
# Para voltar ao fluxo síncrono de antes: TEMPORAL_ENABLED=false.
TEMPORAL_ENABLED=true

# TEMPORAL_ADDRESS NÃO entra aqui: dentro da rede do compose o servidor atende
# por `temporal:7233`, e quem define é o docker-compose.yml.

TEMPORAL_POLL_INTERVAL_SECONDS=30
TEMPORAL_PAYMENT_TIMEOUT_MINUTES=60
