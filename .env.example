# Modelo do .env. Copie e preencha:
#
#     cp .env.example .env          (cmd.exe: copy .env.example .env)
#
# Guarda apenas segredos e valores específicos da máquina. A estrutura e os
# defaults da aplicação ficam em config/*.yml — este arquivo só os sobrepõe.
#
# ATENÇÃO: uma variável definida como VAZIA aqui vence o default do YAML
# (`${VAR:-x}` só usa `x` quando a variável não existe). Para ficar com o
# default, comente a linha em vez de deixá-la vazia.

NODE_ENV=development

# ─────────────────────────────────────────────────────────────────────────────
# Postgres
# ─────────────────────────────────────────────────────────────────────────────

POSTGRES_PASSWORD=postgres

# Os demais campos do banco têm default em config/default.yml e batem com o
# docker-compose.yml. Descomente só para apontar para outro banco.
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=postgres
# POSTGRES_DB=payments

# ─────────────────────────────────────────────────────────────────────────────
# Aplicação
# ─────────────────────────────────────────────────────────────────────────────

# Porta HTTP. Mudando aqui, mude também a publicada no docker-compose.yml.
# PORT=3000

# ─────────────────────────────────────────────────────────────────────────────
# Mercado Pago
# ─────────────────────────────────────────────────────────────────────────────

# Vazio faz a API usar o gateway simulado, sem falar com o Mercado Pago.
# Credenciais de teste: painel → Integrações → sua aplicação → Credenciais de
# teste. Começam com APP_USR- (o prefixo TEST- é do modelo antigo).
MERCADO_PAGO_ACCESS_TOKEN=

# Assinatura secreta do painel → Webhooks. Vazia desliga a verificação do
# x-signature (permitido só em desenvolvimento; obrigatória em produção).
# Preenchida com um valor que não seja o do painel, a API rejeita com 401 as
# notificações legítimas.
MERCADO_PAGO_WEBHOOK_SECRET=

# URL pública que o Mercado Pago chama de volta. localhost não serve: quem
# chama é o provedor, de fora da sua máquina. Em desenvolvimento: pnpm tunnel
#
# Comentada, a preferência sai SEM notification_url — ou seja, sem callback.
# É o correto para rodar local sem túnel: melhor não prometer um callback do
# que apontar para um endereço que o provedor não alcança.
# MERCADO_PAGO_NOTIFICATION_URL=https://<id>.trycloudflare.com/api/payment/webhook

# Base pública para as back_urls do Checkout Pro (para onde o cliente volta
# depois de pagar). Vazia omite back_urls e auto_return da preferência.
# MERCADO_PAGO_BACK_URL=https://<id>.trycloudflare.com

# ─────────────────────────────────────────────────────────────────────────────
# Temporal.io
# ─────────────────────────────────────────────────────────────────────────────

# Cada cobrança por cartão vira um workflow durável: retry na criação da
# preferência, espera pelo callback e polling no Mercado Pago quando ele não
# chega. Exige o servidor de pé ANTES da API:
#
#     docker compose up -d      (PostgreSQL, Adminer e Temporal — sem a API)
#
# Com o servidor fora, a API não sobe (e diz o que fazer). Para voltar ao
# fluxo síncrono de antes, sem Temporal: TEMPORAL_ENABLED=false.
TEMPORAL_ENABLED=true

# Servidor gRPC publicado pelo docker-compose.yml na sua máquina. A UI, para
# acompanhar os workflows, fica em http://localhost:8233.
TEMPORAL_ADDRESS=localhost:7233

# true: o worker roda dentro da API — `pnpm start:dev` basta.
# false: a API só inicia workflows; suba o worker em outro terminal com
# `pnpm start:worker:dev`. Sem worker nenhum, cartão fica esperando (202).
TEMPORAL_WORKER_ENABLED=true

# Intervalo do polling no Mercado Pago enquanto o callback não chega, e a
# janela em que o workflow acompanha a cobrança.
TEMPORAL_POLL_INTERVAL_SECONDS=30
TEMPORAL_PAYMENT_TIMEOUT_MINUTES=60

# Defaults em config/default.yml. Descomente só para mudar.
# TEMPORAL_NAMESPACE=default
# TEMPORAL_TASK_QUEUE=payments
